{
  "mcpServers": {
    "datadoe": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@latest",
        "https://api.datadoe.com/mcp/v1",
        "--transport",
        "http-only",
        "--header",
        "datadoe-mcp-key:${DATADOE_MCP_KEY}"
      ],
      "env": {
        "DATADOE_MCP_KEY": "$DATADOE_MCP_KEY"
      }
    }
  }
}
